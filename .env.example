# CareerPilot AI — environment configuration template.
# Copy to `.env` for local development. Never commit real values.

# ---- Client-visible (inlined into the browser bundle at build time) --------
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"   # publishable, safe in the client
VITE_SUPABASE_PROJECT_ID="<project-ref>"
# Optional: base URL for the Axios service layer (defaults to /api)
# VITE_API_BASE_URL="/api"

# ---- Server-only (read inside server function handlers, never in the client)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sbprivate_xxx"  # Service role key for admin operations
# Optional: AI provider API key (OpenAI recommended)
# OPENAI_API_KEY="sk_xxx"

